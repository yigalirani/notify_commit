{
    "files": {
    "includes": [
      "**/src/**",
      "!**/dist",
      "!types",
      "!**/*.json"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "json": {
    "linter": {
      "enabled": false
    }
  },

  "linter": {
    "rules": {
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "warn"
      },
      "complexity": {
        "useArrowFunction": "off", 
        "useOptionalChain": "off",
        "noExcessiveCognitiveComplexity": "off"
      },

      "correctness": {
        "noUnusedImports": "warn",
        "noUnusedFunctionParameters":"warn"
      }
    }
  }
}